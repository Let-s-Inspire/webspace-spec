{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webspacebrowser.com/schemas/experimental/v0/object.schema.json",
  "title": "Webspace experimental object package v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "kind",
    "id",
    "version",
    "metadata",
    "entry",
    "bounds",
    "ownership",
    "multiplicity"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "profile": {
      "const": "https://webspacebrowser.com/profiles/package/experimental-v0"
    },
    "kind": { "const": "object" },
    "id": { "$ref": "package.schema.json#/$defs/packageId" },
    "version": { "$ref": "package.schema.json#/$defs/semver" },
    "canonicalUrl": {
      "$ref": "package.schema.json#/$defs/absoluteHttpsUri"
    },
    "metadata": { "$ref": "package.schema.json#/$defs/metadata" },
    "entry": { "$ref": "package.schema.json#/$defs/executableResource" },
    "modules": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "package.schema.json#/$defs/module" }
    },
    "assets": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "package.schema.json#/$defs/asset" }
    },
    "compatibility": {
      "$ref": "package.schema.json#/$defs/compatibility"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "package.schema.json#/$defs/capability" }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "package.schema.json#/$defs/dependency" }
    },
    "privacy": { "$ref": "package.schema.json#/$defs/privacy" },
    "resources": { "$ref": "package.schema.json#/$defs/resources" },
    "failure": { "$ref": "package.schema.json#/$defs/failure" },
    "extensions": { "$ref": "package.schema.json#/$defs/extensions" },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size"],
      "properties": {
        "size": {
          "allOf": [
            { "$ref": "package.schema.json#/$defs/vector3" },
            {
              "type": "array",
              "prefixItems": [
                { "type": "number", "exclusiveMinimum": 0 },
                { "type": "number", "exclusiveMinimum": 0 },
                { "type": "number", "exclusiveMinimum": 0 }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            }
          ]
        },
        "center": { "$ref": "package.schema.json#/$defs/vector3" }
      }
    },
    "footprint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "radius": { "type": "number", "exclusiveMinimum": 0 },
        "clearance": { "type": "number", "minimum": 0 },
        "surface": { "enum": ["floor", "wall", "ceiling", "any"] }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial"],
      "properties": {
        "initial": { "enum": ["world", "placer", "authority", "unowned"] },
        "transferable": { "type": "boolean" }
      }
    },
    "multiplicity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perWorld", "perUser"],
      "properties": {
        "perWorld": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "perUser": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "interactions": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "enum": ["point", "activate", "grab", "drag", "use", "focus", "attach"]
      }
    },
    "attachmentPoints": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "transform"],
        "properties": {
          "id": { "$ref": "package.schema.json#/$defs/identifier" },
          "transform": { "$ref": "package.schema.json#/$defs/transform" },
          "accepts": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "package.schema.json#/$defs/featureName" }
          }
        }
      }
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputs": { "$ref": "#/$defs/ports" },
        "outputs": { "$ref": "#/$defs/ports" }
      }
    },
    "replication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["none", "local", "authority"] },
        "provider": { "$ref": "package.schema.json#/$defs/absoluteHttpsUri" }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["none", "session", "world", "user"] },
        "maxBytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onOwnerLeave": { "enum": ["keep", "remove", "transfer"] },
        "idleSeconds": { "type": "integer", "minimum": 0, "maximum": 31536000 }
      }
    }
  },
  "$defs": {
    "ports": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "schema"],
        "properties": {
          "name": { "$ref": "package.schema.json#/$defs/identifier" },
          "schema": {
            "oneOf": [
              { "type": "object" },
              { "$ref": "package.schema.json#/$defs/absoluteHttpsUri" }
            ]
          }
        }
      }
    }
  }
}
