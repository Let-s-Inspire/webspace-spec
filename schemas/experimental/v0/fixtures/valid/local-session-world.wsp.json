{
  "$schema": "https://webspacebrowser.com/schemas/experimental/v0/world.schema.json",
  "profile": "https://webspacebrowser.com/profiles/package/experimental-v0",
  "kind": "world",
  "id": "com.example.local-session-world",
  "version": "0.1.0",
  "metadata": { "name": "Local Session World" },
  "entry": {
    "module": "package:/resources/world.js",
    "integrity": "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
  },
  "presentation": { "backgroundColor": "#101820" },
  "session": { "mode": "local" },
  "authority": { "mode": "none" },
  "entrances": [{
    "id": "main",
    "transform": {
      "position": [0, 1.7, 0],
      "orientation": [0, 0, 0, 1]
    }
  }],
  "defaultEntrance": "main"
}
