{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webspacebrowser.com/schemas/experimental/v0/local-identity-delegation.schema.json",
  "title": "Experimental ID1 local identity delegation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "algorithm",
    "parentPublicKey",
    "delegatedPublicKey",
    "canonicalWorld",
    "audience",
    "scopes",
    "issuedAt",
    "expiresAt",
    "parentSignature"
  ],
  "properties": {
    "version": { "const": 1 },
    "algorithm": { "const": "Ed25519" },
    "parentPublicKey": { "$ref": "#/$defs/base64url" },
    "delegatedPublicKey": { "$ref": "#/$defs/base64url" },
    "canonicalWorld": {
      "type": "string",
      "pattern": "^webspace-world:v1:https://[^/?#]+/[a-z0-9](?:[a-z0-9-]{0,62}\\.)+[a-z0-9][a-z0-9-]{0,62}$"
    },
    "audience": { "type": "string", "format": "uri" },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
      }
    },
    "issuedAt": { "type": "integer", "minimum": 0 },
    "expiresAt": { "type": "integer", "minimum": 1 },
    "parentSignature": { "$ref": "#/$defs/base64url" }
  },
  "$defs": {
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
